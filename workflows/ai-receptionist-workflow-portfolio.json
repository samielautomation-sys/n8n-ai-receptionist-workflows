    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output ?? $input.first().json.text ?? '';\nconst ctx = $('Build Context').first().json;\nlet p = null;\ntry {\n  const m = String(raw).match(/\\{[\\s\\S]*\\}/);\n  p = JSON.parse(m ? m[0] : raw);\n} catch (e) { p = null; }\nif (!p || typeof p.reply !== 'string') {\n  p = { reply: \"Thanks for your message! I've passed this to the team and someone will get back to you shortly. 🙏\", escalate: true, owner_note: 'AI reply could not be processed - please respond manually.', booking: null };\n}\nconst b = p.booking && typeof p.booking === 'object' ? p.booking : null;\nreturn [{ json: {\n  reply: p.reply,\n  escalate: p.escalate === true,\n  owner_note: p.owner_note || '',\n  booking_present: !!b,\n  booking: b || {},\n  customer_phone: ctx.customer_phone,\n  customer_name: ctx.customer_name,\n  customer_question: ctx.user_message\n} }];"
      },
